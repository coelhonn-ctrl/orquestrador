# Copie para .env e ajuste. Tudo é opcional.

# Onde o app escuta. Para acessar do celular, use 0.0.0.0 (ou o IP do Tailscale) E defina um token.
ORQ_HOST=127.0.0.1
ORQ_PORTA=4700
ORQ_TOKEN=

# Vault do Obsidian (base de conhecimento comum). Pode apontar para um vault que você já usa.
ORQ_VAULT=./vault
ORQ_DADOS=./data

# Quantas tarefas rodam ao mesmo tempo. O gestor sempre planeja uma por vez.
ORQ_MAX_ATIVAS=2
# Tempo máximo de uma etapa, em minutos.
ORQ_TIMEOUT_MIN=30
# Por quanto tempo uma IA sem cota fica fora do remanejamento.
ORQ_PAUSA_LIMITE_MIN=60

# Postgres e Redis (docker compose up -d). Sem eles, o app guarda tudo em data/estado.json.
# DATABASE_URL=postgres://orq:orq@127.0.0.1:5433/orq
# REDIS_URL=redis://127.0.0.1:6380

# 1 = todas as equipes usam o modo simulado, sem chamar nenhuma IA.
ORQ_SIMULAR=0
