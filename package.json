{
  "name": "singularize-orquestrador",
  "version": "1.9.3",
  "description": "Singularize Orquestrador: orquestrador geral de IAs de terminal, com gestor, equipes, tela livre e agentes que conversam entre si.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "abrir": "node src/server.js --abrir",
    "dev": "node --watch src/server.js",
    "simular": "node src/server.js --simular",
    "app": "electron .",
    "empacotar:win": "node desktop/empacotar.mjs win",
    "empacotar:linux": "node desktop/empacotar.mjs linux"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "3d-force-graph": "^1.77.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "main": "desktop/main.cjs",
  "author": "Singularize",
  "build": {
    "appId": "com.singularize.orquestrador",
    "productName": "Singularize Orquestrador",
    "executableName": "singularize-orquestrador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/*.cjs",
      "src/**",
      "public/**",
      "bin/**",
      "sql/**",
      "instalador/icone.*",
      "orq.config.json",
      "MANUAL.md",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "icon": "instalador/icone.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "instalador/icone.png",
      "category": "Development",
      "artifactName": "Singularize-Orquestrador-${version}.AppImage",
      "synopsis": "Orquestrador geral de IAs de terminal"
    }
  }
}
